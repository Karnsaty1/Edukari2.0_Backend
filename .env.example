PORT=5000
NODE_ENV=development

# Option A: multi-var connection
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_HOST=cluster0.hfsa6.mongodb.net
MONGODB_DATABASE=edukari
MONGODB_OPTIONS=retryWrites=true&w=majority&appName=Cluster0

# Option B: Atlas template string with placeholder
# MONGODB_URI=mongodb+srv://your_username:<db_password>@cluster0.hfsa6.mongodb.net/?appName=Cluster0
# MONGODB_PASSWORD=your_password

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=2d

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Live classroom / SFU
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_WS_URL=wss://your-livekit-host

CLIENT_ORIGIN=http://localhost:5173
